POSTGRES_PASSWORD=replace-with-a-local-password
# URI-encode reserved characters in the password when setting the DSN.
GUARD_DATABASE_DSN=postgres://guard:replace-with-a-local-password@postgres:5432/guard?sslmode=disable
GUARD_MODEL_BASE_URL=http://host.docker.internal:8000/v1
GUARD_MODEL_NAME=Qwen/Qwen3-VL-2B-Thinking
GUARD_MODEL_BACKEND=vllm
GUARD_MODEL_API_KEY=local
GUARD_MODEL_RESPONSE_FORMAT=json_schema
